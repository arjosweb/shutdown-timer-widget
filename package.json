{
  "name": "shutdown-timer-widget",
  "version": "1.0.0",
  "description": "Shutdown Timer Widget - Widget flutuante para agendamento de desligamento",
  "main": "out/main.js",
  "scripts": {
    "start": "npm run build && env ELECTRON_RUN_AS_NODE= electron .",
    "build": "tsc && tsc src/renderer/renderer.ts --target ES6 --module None --outDir out/renderer --skipLibCheck && mkdir -p out/renderer && cp renderer/*.html out/renderer/ && cp renderer/*.css out/renderer/",
    "pack:mac": "npm run build && electron-builder --mac",
    "pack:win": "npm run build && electron-builder --win",
    "pack:linux": "npm run build && electron-builder --linux",
    "pack:all": "npm run build && electron-builder --mac --win --linux"
  },
  "build": {
    "appId": "com.shutdown-timer.widget",
    "productName": "Shutdown Timer",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png"
    },
    "dmg": {
      "iconSize": 100,
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": "portable",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/icon.png"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ]
  },
  "author": {
    "name": "Artur Medeiros (ARJOS Tech)",
    "email": "contato@arjos.com.br"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arjosweb/shutdown-timer-widget.git"
  },
  "bugs": {
    "url": "https://github.com/arjosweb/shutdown-timer-widget/issues"
  },
  "homepage": "https://github.com/arjosweb/shutdown-timer-widget#readme",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.2.3",
    "electron": "^28.3.3",
    "electron-builder": "^26.7.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "sudo-prompt": "^9.2.1"
  }
}